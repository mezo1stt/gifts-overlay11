# منفذ الخادم
PORT=3001

# ==============================================================
# ☁️ إعدادات الحفظ السحابي الدائم على Render (اختر الطريقة المناسبة لك)
# ==============================================================

# الطريقة الأولى (الأفضل والموصى بها): Cloudinary مجاني 25GB للأبد
# أنشئ حساباً مجانياً من: https://cloudinary.com
# ثم انسخ بياناتك من لوحة تحكم Cloudinary وضعها هنا:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# الطريقة الثانية: ImgBB (مفتاح مجاني خلال 10 ثوانٍ)
# احصل على مفتاح API مجاني بدون بطاقة من: https://api.imgbb.com
IMGBB_API_KEY=

# الطريقة الثالثة: قاعدة بيانات سحابية دائمة (MongoDB Atlas مجاني 512MB)
# لحفظ أسماء الهدايا وترتيبها ومواقعها للأبد حتى لو أُعيد تشغيل سيرفر Render
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/gifts_db?retryWrites=true&w=majority

# مسار القرص الثابت على Render (في حال اشتراك Render Disk مدفوع)
# DATA_DIR=/var/data
